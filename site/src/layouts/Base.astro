---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/texture.css';
import '../styles/controls.css';
import '../styles/shell.css';
import '../styles/sheet.css';
import 'katex/dist/katex.min.css';
import ThemeScript from '../components/ThemeScript.astro';
import ThemePicker from '../components/ThemePicker.astro';
import ModeToggle from '../components/ModeToggle.astro';
import Handle from '../components/Handle.astro';
import SidebarDrawer from '../components/SidebarDrawer';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Props {
	title?: string;
	/** Page-specific summary for <meta name="description"> and OG/Twitter
	 *  tags — should describe this page's actual content, not be generic
	 *  boilerplate. Falls back to the site-wide description when a page
	 *  hasn't been given one yet. */
	description?: string;
	/** Docs reading layout: the page owns its own gutters and TOC column. */
	docs?: boolean;
}

const { title = site.tabTitle, description = site.description, docs = false } = Astro.props;
const documentTitle =
	title === site.tabTitle ? site.tabTitle : `${title} · ${site.tabTitle}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// No dedicated OG image exists yet — the favicon is a real, if minimal,
// stand-in rather than shipping no image at all.
const ogImageUrl = new URL('/favicon.svg', Astro.site);
---

<html lang="en" data-scheme={site.defaultScheme} data-mode={site.defaultMode}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
		<title>{documentTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" type="application/rss+xml" title={site.tabTitle} href="/rss.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={documentTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<ThemeScript />
		<slot name="head" />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<div class="shell">
			<div class="toolbar-backdrop" aria-hidden="true"></div>
			<header class="toolbar">
				<SidebarDrawer client:only="react">
					<button type="button" class="ctrl-btn" aria-label="Open sidebar" slot="fallback">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							aria-hidden="true"
						>
							<path d="M4 5h16"></path>
							<path d="M4 12h16"></path>
							<path d="M4 19h16"></path>
						</svg>
					</button>
				</SidebarDrawer>
				<div class="theme-controls">
					<ThemePicker />
					<ModeToggle />
					<Handle />
				</div>
			</header>

			<main id="main-content" class={docs ? 'shell__main shell__main--docs' : 'shell__main'}>
				{
					docs ? (
						<slot />
					) : (
						<div class="container">
							<slot />
						</div>
					)
				}
			</main>

			<div class="container">
				<Footer />
			</div>
		</div>

		<script>
			import { bindUi } from '../lib/ui';
			bindUi();
		</script>
	</body>
</html>

<style>
	.theme-controls {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
</style>
