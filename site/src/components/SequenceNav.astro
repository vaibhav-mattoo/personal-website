---
export type SequenceEntry = {
	topicId: string;
	topicTitle: string;
	position: number;
	total: number;
	prev?: { id: string; title: string };
	next?: { id: string; title: string };
};

interface Props {
	sequences: SequenceEntry[];
}

const { sequences } = Astro.props;
---

{
	sequences.length > 0 && (
		<section class="sequence-nav" aria-label="Series navigation">
			{sequences.map((seq) => (
				<div class="sequence-nav__item">
					<div class="sequence-nav__head">
						<a class="sequence-nav__topic" href={`/notes/topics/${seq.topicId}/`}>
							{seq.topicTitle}
						</a>
						<span class="sequence-nav__part">
							Part {seq.position} of {seq.total}
						</span>
					</div>
					<div class="sequence-nav__links">
						{seq.prev ? (
							<a class="sequence-nav__link" href={`/notes/${seq.prev.id}/`}>
								← {seq.prev.title}
							</a>
						) : (
							<span class="sequence-nav__link sequence-nav__link--disabled">Start</span>
						)}
						{seq.next ? (
							<a class="sequence-nav__link sequence-nav__link--next" href={`/notes/${seq.next.id}/`}>
								{seq.next.title} →
							</a>
						) : (
							<span class="sequence-nav__link sequence-nav__link--disabled sequence-nav__link--next">
								End
							</span>
						)}
					</div>
				</div>
			))}
		</section>
	)
}

<style>
	.sequence-nav {
		margin: 2rem 0 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.sequence-nav__item {
		padding: 0.85rem 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--card);
	}

	.sequence-nav__head {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.sequence-nav__topic {
		font-family: var(--font-display);
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent);
		text-decoration: none;
	}

	.sequence-nav__topic:hover {
		text-decoration: underline;
	}

	.sequence-nav__part {
		font-family: var(--font-display);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.sequence-nav__links {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 0.5rem;
		font-family: var(--font-body);
	}

	.sequence-nav__link {
		color: var(--fg);
		text-decoration: none;
	}

	.sequence-nav__link:hover {
		color: var(--accent);
	}

	.sequence-nav__link--disabled {
		color: var(--muted);
	}

	.sequence-nav__link--next {
		margin-left: auto;
		text-align: right;
	}
</style>
