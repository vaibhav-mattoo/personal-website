---
import type { TopicNode } from '../lib/topics';

interface Props {
	node: TopicNode;
	depth?: number;
	/** Subtopics stay collapsed until you hover/focus the parent — used on
	 * the /notes hub, the only place this component renders now, to keep
	 * the topic list uncluttered while still showing the full tree. */
	hoverReveal?: boolean;
}

const { node, depth = 0, hoverReveal = false } = Astro.props;
const visibleChildren = node.children.filter((child) => !child.hidden);
const d = Math.min(depth, 3);
---

<li class={`topic-node topic-node--d${d}`} data-hover-reveal={hoverReveal}>
	<a class="topic-node__link" href={`/notes/topics/${node.id}/`}>
		<span class="topic-node__title">{node.title}</span>
		<span class="topic-node__count">{node.notes.length}</span>
	</a>
	{
		visibleChildren.length > 0 && (
			<div class="topic-node__children-outer">
				<ul class="topic-node__children">
					{visibleChildren.map((child) => (
						<Astro.self node={child} depth={depth + 1} hoverReveal={hoverReveal} />
					))}
				</ul>
			</div>
		)
	}
</li>

<style>
	.topic-node {
		margin: 0;
	}

	.topic-node__link {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.5rem 0;
		color: var(--fg);
		text-decoration: none;
		border-bottom: 1px solid var(--border);
	}

	.topic-node__link:hover .topic-node__title {
		color: var(--accent);
	}

	.topic-node__title {
		font-family: var(--font-body);
	}

	.topic-node--d0 > .topic-node__link .topic-node__title {
		font-size: 1.3rem;
		font-weight: 700;
	}

	.topic-node--d1 > .topic-node__link .topic-node__title {
		font-size: 1.05rem;
		font-weight: 600;
	}

	.topic-node--d2 > .topic-node__link .topic-node__title,
	.topic-node--d3 > .topic-node__link .topic-node__title {
		font-size: 0.9rem;
		font-weight: 500;
	}

	.topic-node__count {
		font-family: var(--font-display);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.topic-node__children {
		margin: 0.25rem 0 0.5rem;
		padding-left: 1.25rem;
		list-style: none;
		overflow: hidden;
		min-height: 0;
	}

	.topic-node__children .topic-node__link {
		border-bottom: none;
		padding: 0.35rem 0;
	}

	/* Always-expanded (default): no extra wrapper behavior needed — the
	   outer div just passes its child through, sized to content. */
	.topic-node__children-outer {
		display: grid;
		grid-template-rows: 1fr;
	}

	/* Hover-reveal mode: subtopics collapse to zero height until the parent
	   <li> is hovered or a child inside it gets keyboard focus. The 0fr/1fr
	   grid-template-rows trick animates height without knowing it upfront.
	   The collapse transition carries a delay (but the expand one doesn't) so
	   briefly overshooting the row while moving the mouse doesn't slam it
	   shut — re-entering within the delay window cancels the collapse. */
	.topic-node[data-hover-reveal='true'] > .topic-node__children-outer {
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.25s ease 0.35s;
	}

	.topic-node[data-hover-reveal='true']:hover > .topic-node__children-outer,
	.topic-node[data-hover-reveal='true']:focus-within > .topic-node__children-outer {
		grid-template-rows: 1fr;
		transition: grid-template-rows 0.15s ease;
	}

	.topic-node[data-hover-reveal='true'] > .topic-node__children-outer > .topic-node__children {
		margin-top: 0;
	}
</style>
