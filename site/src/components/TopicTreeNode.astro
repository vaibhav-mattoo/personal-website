---
import type { TopicNode } from '../lib/topics';

interface Props {
	node: TopicNode;
}

const { node } = Astro.props;
const visibleChildren = node.children.filter((child) => !child.hidden);
---

<li class="topic-node">
	<a class="topic-node__link" href={`/notes/tags/${node.id}/`}>
		<span class="topic-node__title">{node.title}</span>
		<span class="topic-node__count">{node.notes.length}</span>
	</a>
	{
		visibleChildren.length > 0 && (
			<ul class="topic-node__children">
				{visibleChildren.map((child) => (
					<Astro.self node={child} />
				))}
			</ul>
		)
	}
</li>

<style>
	.topic-node {
		margin: 0;
	}

	.topic-node__link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.5rem 0;
		color: var(--fg);
		text-decoration: none;
		border-bottom: 1px solid var(--border);
	}

	.topic-node__link:hover .topic-node__title {
		color: var(--accent);
	}

	.topic-node__title {
		font-family: var(--font-body);
		font-weight: 600;
	}

	.topic-node__count {
		font-family: var(--font-display);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.topic-node__children {
		margin: 0.25rem 0 0.5rem;
		padding-left: 1.25rem;
		list-style: none;
	}

	.topic-node__children .topic-node__link {
		border-bottom: none;
		padding: 0.35rem 0;
	}
</style>
