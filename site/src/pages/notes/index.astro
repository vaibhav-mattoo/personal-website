---
import Base from '../../layouts/Base.astro';
import TerminalPrompt from '../../components/TerminalPrompt.astro';
import TopicTreeNode from '../../components/TopicTreeNode.astro';
import GraphExplorer from '../../components/GraphExplorer';
import { getPublicVault } from '../../lib/vault';
import { getTopicTree, getGraphData } from '../../lib/topicVault';

// getPublicVault(), not getCollection('notes') directly — this is a public
// listing, so it must go through isVisible() like every other one (drafts
// hidden outside dev, shared notes never listed here at all).
const { entries } = await getPublicVault();
const recentNotes = [...entries].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 3);

const tree = await getTopicTree();
const roots = tree.roots.filter((node) => !node.hidden);

const graphData = await getGraphData();
---

<Base title="Notes">
	<header class="head">
		<h1>Notes</h1>
		<p>
			Markdown files in <code>src/content/notes/</code> publish here automatically.
			<a href="/notes/documents/">Documents →</a>
		</p>
	</header>

	<TerminalPrompt command="ls notes/" />

	{
		roots.length > 0 && (
			<section class="section">
				<h2>Topics</h2>
				<p class="section__hint">Hover a topic to see its subtopics.</p>
				<ul class="topic-tree">
					{roots.map((node) => (
						<TopicTreeNode node={node} hoverReveal />
					))}
				</ul>
			</section>
		)
	}

	<section class="section">
		<h2>Explore visually</h2>
		<GraphExplorer client:visible data={graphData} />
	</section>

	{
		recentNotes.length > 0 && (
			<section class="section recent">
				<h2>Recent</h2>
				<ul class="recent__list">
					{recentNotes.map((note) => (
						<li>
							<a href={`/notes/${note.id}/`} class="recent__item">
								<span class="recent__row">
									<span class="recent__title">{note.title}</span>
									<time datetime={note.date.toISOString()} class="recent__date">
										{note.date.toLocaleDateString()}
									</time>
								</span>
								{note.summary && <span class="recent__summary">{note.summary}</span>}
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>

<style>
	.head {
		margin: 2rem 0 1.5rem;
	}

	.head h1 {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-family: var(--font-body);
		font-size: clamp(2rem, 5vw, 2.75rem);
	}

	.head p {
		margin: 0;
		color: var(--muted);
		font-family: var(--font-body);
	}

	.head code {
		font-family: var(--font-display);
		font-size: 0.9em;
	}

	.section {
		margin: 2.5rem 0;
	}

	.section h2 {
		margin: 0 0 0.35rem;
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
	}

	.section__hint {
		margin: 0 0 0.75rem;
		font-family: var(--font-body);
		font-size: 0.85rem;
		color: var(--muted);
	}

	.section__hint a {
		color: var(--accent);
	}

	.topic-tree {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* A quiet, compact footer list — not competing with Topics/the graph
	   above for attention, just quick access to what's newest. */
	.recent {
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}

	.recent__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.recent__list a {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.5rem 0;
		color: var(--fg);
		text-decoration: none;
		border-bottom: 1px solid var(--border);
	}

	.recent__list li:last-child a {
		border-bottom: none;
	}

	.recent__row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.recent__list a:hover .recent__title {
		color: var(--accent);
	}

	.recent__title {
		font-family: var(--font-body);
		font-size: 0.9rem;
	}

	.recent__date {
		font-family: var(--font-display);
		font-size: 0.78rem;
		color: var(--muted);
		white-space: nowrap;
	}

	.recent__summary {
		font-family: var(--font-body);
		font-size: 0.82rem;
		color: var(--muted);
	}

	:global(.graph-explorer) {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	:global(.graph-explorer__controls) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	:global(.graph-explorer__search) {
		flex: 1 1 14rem;
		min-width: 0;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		color: var(--fg);
		font-family: var(--font-body);
		font-size: 0.9rem;
	}

	:global(.graph-explorer__search:focus) {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 1px var(--accent);
	}

	:global(.graph-explorer__chips) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	:global(.graph-explorer__chip) {
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--card);
		color: var(--fg);
		font-family: var(--font-display);
		font-size: 0.78rem;
		cursor: pointer;
		transition:
			border-color 0.15s,
			color 0.15s,
			background-color 0.15s;
	}

	:global(.graph-explorer__chip:hover) {
		border-color: var(--accent);
		color: var(--accent);
	}

	:global(.graph-explorer__chip[data-active='true']) {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--accent);
	}

	:global(.graph-explorer__chip--clear) {
		color: var(--muted);
	}

	:global(.graph-canvas) {
		width: 100%;
		height: 50vh;
		min-height: 20rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--bg);
	}

	:global(.graph-canvas canvas) {
		border-radius: var(--radius-lg);
	}

	:global(.graph-explorer__legend) {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		font-family: var(--font-display);
		font-size: 0.78rem;
		color: var(--muted);
	}

	:global(.graph-explorer__legend-item) {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	:global(.graph-explorer__legend-item svg) {
		flex-shrink: 0;
	}

	:global(.graph-explorer__legend-item line) {
		stroke: var(--muted);
		stroke-width: 1.5;
	}
</style>
