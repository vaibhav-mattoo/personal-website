---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import readingTime from 'reading-time';
import Base from '../../layouts/Base.astro';
import NoteMeta from '../../components/NoteMeta.astro';
import Toc from '../../components/Toc.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import Backlinks from '../../components/Backlinks.astro';
import Comments from '../../components/Comments.astro';
import SequenceNav from '../../components/SequenceNav.astro';
import LocalGraph from '../../components/LocalGraph.astro';
import { getBacklinks } from '../../lib/backlinks';
import { getPublicVault } from '../../lib/vault';
import { getTopicTree, getGraphData } from '../../lib/topicVault';
import { sequenceNeighbors } from '../../lib/topics';
import { neighborhood } from '../../lib/links';
import '../../styles/docs.css';
import '../../styles/prose.css';

export async function getStaticPaths() {
	const notes = await getCollection('notes');
	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

interface Props {
	note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content, headings } = await render(note);

const words = (note.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const stats = readingTime(note.body ?? '');
const minutes = Math.max(1, Math.ceil(stats.minutes));

const backlinks = await getBacklinks(note.id);

// If this note appears in any topic's curated sequence, surface prev/next +
// "Part N of M" for every such topic — a note can belong to more than one.
const tree = await getTopicTree();
const { entries: publicEntries } = await getPublicVault();
const titleById = new Map(publicEntries.map((e) => [e.id, e.title]));

const sequences = [...tree.byId.values()]
	.filter((topicNode) => topicNode.sequence.includes(note.id))
	.map((topicNode) => {
		const neighbors = sequenceNeighbors(topicNode, note.id);
		const prevTitle = neighbors.prev ? titleById.get(neighbors.prev) : undefined;
		const nextTitle = neighbors.next ? titleById.get(neighbors.next) : undefined;
		return {
			topicId: topicNode.id,
			topicTitle: topicNode.title,
			position: neighbors.position ?? 0,
			total: neighbors.total,
			prev: neighbors.prev && prevTitle ? { id: neighbors.prev, title: prevTitle } : undefined,
			next: neighbors.next && nextTitle ? { id: neighbors.next, title: nextTitle } : undefined,
		};
	});

// Local graph: depth-1 neighborhood computed at build time (not the whole
// vault) so each note page's payload stays O(neighborhood size), not
// O(vault size) — same reduction Graph.tsx does client-side for graph.astro,
// applied here server-side since we already know the one node we care about.
const fullGraph = await getGraphData();
const localGraphData = neighborhood(
	{
		nodes: fullGraph.nodes,
		edges: fullGraph.edges.map((e) => ({ ...e, broken: false })),
	},
	note.id,
	1,
);
---

<Base title={note.data.title} docs>
	<ReadingProgress />

	<div class="docs">
		<Toc headings={headings} localGraph={{ data: localGraphData, focusId: note.id }} />

		<div class="docs__graph">
			<LocalGraph data={localGraphData} focusId={note.id} />
		</div>

		<article class="docs__main" data-pagefind-body>
			<header class="note-head">
				<h1>{note.data.title}</h1>
				{note.data.summary && <p class="note-head__summary">{note.data.summary}</p>}
				<NoteMeta date={note.data.date} minutes={minutes} words={words} />
			</header>

			<div class="prose docs__prose">
				<Content />
			</div>

			<p class="note__back"><a href="/notes/">← All notes</a></p>

			<SequenceNav sequences={sequences} />

			<Backlinks links={backlinks} />
			<Comments />
		</article>
	</div>
</Base>

<script>
	import mediumZoom from 'medium-zoom';
	mediumZoom('.prose img', {
		margin: 24,
		background: 'rgba(0,0,0,0.85)',
	});
</script>

<style>
	.note-head {
		margin: 0 0 0.5rem;
	}

	.note-head h1 {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-family: var(--font-body);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.note-head__summary {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.note__back {
		margin: 2rem 0 0;
		font-family: var(--font-display);
		font-size: 0.9rem;
	}

	.note__back a {
		color: var(--muted);
		text-decoration: none;
	}

	.note__back a:hover {
		color: var(--accent);
	}
</style>
