---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import readingTime from 'reading-time';
import Base from '../../layouts/Base.astro';
import NoteMeta from '../../components/NoteMeta.astro';
import Toc from '../../components/Toc.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import Backlinks from '../../components/Backlinks.astro';
import Comments from '../../components/Comments.astro';
import { getBacklinks } from '../../lib/backlinks';
import '../../styles/docs.css';
import '../../styles/prose.css';

export async function getStaticPaths() {
	const notes = await getCollection('notes');
	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

interface Props {
	note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content, headings } = await render(note);

const words = (note.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const stats = readingTime(note.body ?? '');
const minutes = Math.max(1, Math.ceil(stats.minutes));

const backlinks = await getBacklinks(note.id);
---

<Base title={note.data.title} docs>
	<ReadingProgress />

	<div class="docs">
		<Toc headings={headings} />

		<article class="docs__main" data-pagefind-body>
			<header class="note-head">
				<h1>{note.data.title}</h1>
				{note.data.summary && <p class="note-head__summary">{note.data.summary}</p>}
				<NoteMeta date={note.data.date} minutes={minutes} words={words} />
			</header>

			<div class="prose docs__prose">
				<Content />
			</div>

			<p class="note__back"><a href="/notes/">← All notes</a></p>

			<Backlinks links={backlinks} />
			<Comments />
		</article>
	</div>
</Base>

<script>
	import mediumZoom from 'medium-zoom';
	mediumZoom('.prose img', {
		margin: 24,
		background: 'rgba(0,0,0,0.85)',
	});
</script>

<style>
	.note-head {
		margin: 0 0 0.5rem;
	}

	.note-head h1 {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-family: var(--font-body);
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.note-head__summary {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.note__back {
		margin: 2rem 0 0;
		font-family: var(--font-display);
		font-size: 0.9rem;
	}

	.note__back a {
		color: var(--muted);
		text-decoration: none;
	}

	.note__back a:hover {
		color: var(--accent);
	}
</style>
