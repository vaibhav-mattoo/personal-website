---
import Base from '../../../layouts/Base.astro';
import TerminalPrompt from '../../../components/TerminalPrompt.astro';
import { getPublicVault } from '../../../lib/vault';

// Documents are just kind: 'document' notes (usually filed under
// notes/lit/, same convention as papers) — this page is a thin filtered
// view over the vault, not a separate data source. See CLAUDE.md/
// content.config.ts: adding one is "add a note", not "edit a config file".
const { entries } = await getPublicVault();
const documents = entries
	.filter((e) => e.kind === 'document')
	.sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<Base title="Documents" description="Documents I've decided to share, with the source linked directly.">
	<header class="head">
		<h1>Documents</h1>
		<p>Documents I've decided to share. Click any tile to open the source in a new tab.</p>
	</header>

	<TerminalPrompt command="ls documents/" />

	{
		documents.length === 0 ? (
			<p class="empty">No documents yet.</p>
		) : (
			<nav class="tiles">
				{documents.map((d) => (
					<a class="tile" href={d.url} target="_blank" rel="noopener">
						<span class="tile__title">{d.title} ↗</span>
						<time class="tile__meta" datetime={d.date.toISOString()}>
							{d.date.toLocaleDateString(undefined, { year: 'numeric', month: 'long' })}
						</time>
						{d.summary && <span class="tile__desc">{d.summary}</span>}
					</a>
				))}
			</nav>
		)
	}

	<p class="back"><a href="/notes/">← back to notes</a></p>
</Base>

<style>
	.head {
		margin: 2rem 0 1rem;
	}

	.head h1 {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-family: var(--font-body);
		font-size: clamp(2rem, 5vw, 2.75rem);
	}

	.head p {
		margin: 0;
		color: var(--muted);
		font-family: var(--font-body);
	}

	.empty {
		color: var(--muted);
		font-style: italic;
		margin: 1rem 0;
	}

	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: var(--s-3);
		margin: 0.25rem 0 1rem;
	}

	.tile {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.7rem 0.85rem;
		border: 1px solid transparent;
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--fg);
		text-decoration: none;
		transition:
			border-color var(--dur-fast) var(--ease),
			color var(--dur-fast) var(--ease),
			background-color var(--dur-fast) var(--ease);
	}

	.tile:hover {
		border-color: var(--accent);
		color: var(--accent);
		background: var(--accent-soft);
	}

	.tile__title {
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 600;
	}

	.tile__meta {
		font-family: var(--font-display);
		font-size: 0.75rem;
		color: var(--muted);
	}

	.tile:hover .tile__meta {
		color: var(--accent);
	}

	.tile__desc {
		font-family: var(--font-body);
		font-size: 0.82rem;
		color: var(--muted);
	}

	.tile:hover .tile__desc {
		color: var(--accent);
	}

	.back {
		margin-top: 2rem;
		font-family: var(--font-display);
	}

	.back a {
		color: var(--muted);
		text-decoration: none;
	}

	.back a:hover {
		color: var(--accent);
	}
</style>
