---
import Base from '../../../layouts/Base.astro';
import TerminalPrompt from '../../../components/TerminalPrompt.astro';
import TopicTreeNode from '../../../components/TopicTreeNode.astro';
import { getTopicTree } from '../../../lib/topicVault';

const tree = await getTopicTree();
const roots = tree.roots.filter((node) => !node.hidden);
---

<Base title="Tags">
	<header class="head">
		<h1>Tags</h1>
		<p>Every topic and tag used across notes, nested by path.</p>
	</header>

	<TerminalPrompt command="tree tags/" />

	{
		roots.length > 0 ? (
			<ul class="topic-tree">
				{roots.map((node) => (
					<TopicTreeNode node={node} />
				))}
			</ul>
		) : (
			<p class="empty">No tags yet.</p>
		)
	}
</Base>

<style>
	.head {
		margin: 2rem 0 1.5rem;
	}
	.head h1 {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-family: var(--font-body);
		font-size: clamp(2rem, 5vw, 2.75rem);
	}
	.head p {
		margin: 0;
		color: var(--muted);
		font-family: var(--font-body);
	}
	.topic-tree {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.empty {
		color: var(--muted);
		font-style: italic;
		margin: 1rem 0;
	}
</style>
