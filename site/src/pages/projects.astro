---
import Base from '../layouts/Base.astro';
import TerminalPrompt from '../components/TerminalPrompt.astro';
import { projects, githubUsername } from '../config/projects';
import { fetchRepoMeta } from '../lib/github';
import '../styles/projects-page.css';

const meta = await fetchRepoMeta(
	githubUsername,
	projects.map((p) => p.repo),
);
---

<Base title="Projects">
	<header class="head">
		<h1>Projects</h1>
		<p>
			Open-source things I've built. Stars are pulled from GitHub at build time; everything
			else is hand-written.
		</p>
	</header>

	<TerminalPrompt command="ls projects/" />

	<div class="cards">
		{
			projects.map((p) => {
				const repoUrl = `https://github.com/${githubUsername}/${p.repo}`;
				const stars = meta[p.repo]?.stars;
				const displayName = p.name ?? p.repo;

				return (
					<article class="card">
						{stars !== undefined && (
							<a
								class="stars"
								href={`${repoUrl}/stargazers`}
								target="_blank"
								rel="noopener"
								aria-label={`${stars} stars on GitHub`}
							>
								<span aria-hidden="true">★</span>
								<span class="tabular-nums">{stars.toLocaleString()}</span>
							</a>
						)}

						<div class="card__meta">
							<time class="card__date">{p.year}</time>
							{p.role && <span class="card__role">{p.role}</span>}
						</div>

						<a class="card__title" href={repoUrl} target="_blank" rel="noopener">
							{displayName}
						</a>

						<p class="card__tagline">{p.blurb}</p>

						<div class="card__links">
							{p.writeup && <a class="link" href={p.writeup}>Article</a>}
							{p.demo && (
								<a class="link" href={p.demo} target="_blank" rel="noopener">
									Demo ↗
								</a>
							)}
							<a class="link link--source" href={repoUrl} target="_blank" rel="noopener">
								Source ↗
							</a>
						</div>
					</article>
				);
			})
		}
	</div>
</Base>
