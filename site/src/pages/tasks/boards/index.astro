---
import Base from '../../../layouts/Base.astro';
import TerminalPrompt from '../../../components/TerminalPrompt.astro';
import { publicBoards, fizzyLoginUrl } from '../../../config/public-boards';
---

<Base title="Boards">
	<header class="head">
		<h1>Boards</h1>
		<p>Read-only public views of what I'm working on.</p>
	</header>

	<TerminalPrompt command="ls boards/" />

	{
		publicBoards.length === 0 ? (
			<p class="empty">No public boards yet.</p>
		) : (
			<div class="boards">
				{publicBoards.map((b) => (
					<section class="board">
						<h2>{b.title}</h2>
						<p class="board__desc">
							{b.description ?? 'A live, read-only view of this board — updates as I do.'}
						</p>
						<div class="board__frame">
							<iframe
								src={b.url}
								title={b.title}
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
							/>
						</div>
						{/* Always visible, not conditional on iframe failure — a
						    provider can silently refuse to embed (X-Frame-Options/
						    CSP) without the iframe's error event ever firing, so
						    detecting that reliably isn't possible; this is the
						    dependable fallback instead of a fragile onerror check. */}
						<a class="board__fallback" href={b.url} target="_blank" rel="noopener">
							Open in a new tab ↗
						</a>
					</section>
				))}
			</div>
		)
	}

	<p class="login">
		<a href={fizzyLoginUrl} target="_blank" rel="noopener">Fizzy login ↗</a>
	</p>

	<p class="back"><a href="/tasks/">← back to tasks</a></p>
</Base>

<style>
	.head {
		margin: 2rem 0 1rem;
	}

	.head h1 {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-family: var(--font-body);
		font-size: clamp(2rem, 5vw, 2.75rem);
	}

	.head p {
		margin: 0;
		color: var(--muted);
		font-family: var(--font-body);
	}

	.empty {
		color: var(--muted);
		font-style: italic;
		margin: 1rem 0;
	}

	.boards {
		display: flex;
		flex-direction: column;
		gap: var(--s-9);
		margin: var(--s-4) 0;
	}

	.board h2 {
		margin: 0 0 0.25rem;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		color: var(--fg);
	}

	.board__desc {
		margin: 0 0 var(--s-3);
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--muted);
	}

	.board__frame {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--surface);
	}

	.board__frame iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.board__fallback {
		display: inline-block;
		margin-top: var(--s-2);
		font-family: var(--font-display);
		font-size: 0.78rem;
		color: var(--muted);
		text-decoration: none;
		border-bottom: 1px dotted var(--muted);
	}

	.board__fallback:hover {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	.login {
		margin: 1.5rem 0 0;
		font-family: var(--font-display);
		font-size: 0.8rem;
		color: var(--muted);
	}

	.login a {
		color: var(--muted);
		text-decoration: none;
		border-bottom: 1px dotted var(--muted);
	}

	.login a:hover {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	.back {
		margin-top: 2rem;
		font-family: var(--font-display);
	}

	.back a {
		color: var(--muted);
		text-decoration: none;
	}

	.back a:hover {
		color: var(--accent);
	}
</style>
