---
import Base from '../../layouts/Base.astro';
import TerminalPrompt from '../../components/TerminalPrompt.astro';

const items = [
	{ name: 'boards/', href: '/tasks/boards/', blurb: "Boards I'm actively working on" },
	{ name: 'calendar/', href: '/tasks/calendar/', blurb: 'Book 30 minutes with me' },
];
---

<Base title="Tasks">
	<header class="head">
		<h1>Tasks</h1>
		<p>Boards I'm working on and a calendar to book time.</p>
	</header>

	<TerminalPrompt command="ls tasks/" />

	<nav class="cards">
		{
			items.map((i) => (
				<a class="card" href={i.href}>
					<span class="card__name">{i.name}</span>
					<span class="card__blurb">{i.blurb}</span>
				</a>
			))
		}
	</nav>
</Base>

<style>
	.head {
		margin: 2rem 0 1rem;
	}

	.head h1 {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-family: var(--font-body);
		font-size: clamp(2rem, 5vw, 2.75rem);
	}

	.head p {
		margin: 0;
		color: var(--muted);
		font-family: var(--font-body);
	}

	.cards {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s-4);
		margin: var(--s-1) 0 var(--s-4);
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: var(--s-2);
		flex: 1 1 220px;
		max-width: 260px;
		padding: var(--s-4) var(--s-5);
		border: 1px solid transparent;
		border-radius: var(--radius-lg);
		background: var(--surface);
		text-decoration: none;
		transition:
			border-color var(--dur-fast) var(--ease),
			background-color var(--dur-fast) var(--ease);
	}

	.card:hover {
		border-color: var(--accent);
		background: var(--accent-soft);
	}

	.card__name {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 700;
		color: var(--accent);
	}

	.card__blurb {
		font-family: var(--font-body);
		font-size: var(--text-sm);
		color: var(--fg);
	}
</style>

<script is:inline>
	// Warm the connection to cal.com when the user shows intent to visit
	// the Calendar page. One-shot per page load.
	let warmed = false;

	const warmCalCom = () => {
		if (warmed) return;
		warmed = true;

		const head = document.head;

		const preconnect = document.createElement('link');
		preconnect.rel = 'preconnect';
		preconnect.href = 'https://app.cal.com';
		head.appendChild(preconnect);

		const preload = document.createElement('link');
		preload.rel = 'preload';
		preload.as = 'script';
		preload.href = 'https://app.cal.com/embed/embed.js';
		preload.crossOrigin = 'anonymous';
		head.appendChild(preload);
	};

	const calendarTile = document.querySelector('a[href="/tasks/calendar/"]');
	if (calendarTile) {
		calendarTile.addEventListener('pointerenter', warmCalCom, { once: true });
		calendarTile.addEventListener('focus', warmCalCom, { once: true });
		calendarTile.addEventListener('touchstart', warmCalCom, { once: true, passive: true });
	}
</script>
