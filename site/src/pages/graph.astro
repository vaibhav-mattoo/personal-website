---
import Base from '../layouts/Base.astro';
import TerminalPrompt from '../components/TerminalPrompt.astro';
import GraphExplorer from '../components/GraphExplorer';
import { getGraphData } from '../lib/topicVault';

// Computed directly (not fetched from /graph.json) — same memoized data, no
// build-time network round-trip to our own endpoint. /graph.json stays for
// external/programmatic consumers.
const data = await getGraphData();
---

<Base title="Graph">
	<header class="head">
		<h1>Graph</h1>
		<p>
			Every public note and topic, laid out by how they link together. Click a node to open
			it; hover for a summary. Search highlights matches — it never hides anything. Topic
			chips filter.
		</p>
	</header>

	<TerminalPrompt command="graph --all" />

	<GraphExplorer client:visible data={data} />
</Base>

<style>
	.head {
		margin: 2rem 0 1rem;
	}

	.head h1 {
		margin: 0 0 0.5rem;
		color: var(--accent);
		font-family: var(--font-body);
		font-size: clamp(2rem, 5vw, 2.75rem);
	}

	.head p {
		margin: 0;
		max-width: 42rem;
		color: var(--muted);
		font-family: var(--font-body);
	}

	:global(.graph-explorer) {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 1.5rem 0;
	}

	:global(.graph-explorer__controls) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	:global(.graph-explorer__search) {
		flex: 1 1 14rem;
		min-width: 0;
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		color: var(--fg);
		font-family: var(--font-body);
		font-size: 0.9rem;
	}

	:global(.graph-explorer__search:focus) {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 1px var(--accent);
	}

	:global(.graph-explorer__chips) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	:global(.graph-explorer__chip) {
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--card);
		color: var(--fg);
		font-family: var(--font-display);
		font-size: 0.78rem;
		cursor: pointer;
		transition:
			border-color 0.15s,
			color 0.15s,
			background-color 0.15s;
	}

	:global(.graph-explorer__chip:hover) {
		border-color: var(--accent);
		color: var(--accent);
	}

	:global(.graph-explorer__chip[data-active='true']) {
		border-color: var(--accent);
		background: var(--accent-soft);
		color: var(--accent);
	}

	:global(.graph-explorer__chip--clear) {
		color: var(--muted);
	}

	:global(.graph-canvas) {
		width: 100%;
		height: 70vh;
		min-height: 24rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--card);
	}

	:global(.graph-canvas canvas) {
		border-radius: var(--radius-lg);
	}

	:global(.graph-explorer__legend) {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		font-family: var(--font-display);
		font-size: 0.78rem;
		color: var(--muted);
	}

	:global(.graph-explorer__legend-item) {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	:global(.graph-explorer__legend-item svg) {
		flex-shrink: 0;
	}

	:global(.graph-explorer__legend-item line) {
		stroke: var(--muted);
		stroke-width: 1.5;
	}
</style>
